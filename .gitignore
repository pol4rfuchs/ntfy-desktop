# #
#   Ignore everything
# #

*

# #
#   [WL]: Git Base Folders/Files
# #

!.all-contributorsrc
!.gitignore
!*CHANGELOG.md
!*CODE_OF_CONDUCT.md
!*CONTRIBUTE.md
!*CONTRIBUTING.md
!*DECISION_FLOW.md
!*LICENSE
!*LICENSE.md
!*README.md
!/.gitea
!/.github
!renovate.json

# #
#   [WL]: Manifest Folders
# #

!/Manifest

# #
#   [WL]: Tools Folders
# #

!/Tools

# #
#   [WL]: vendor
# #

!/vendor

# #
#   [WL]: assets
# #

!/assets

# #
#   [WL]: Docs Folder
# #

!/docs
!/pages

# #
#   [WL]: Source Folder
# #

!/lib
!/notifiers

# #
#   [WL]: Editor Config
# #

!.editorconfig

# #
#   [WL]: Signing / Digests
# #

!sign.bat
!*SHA*.asc
!*SHA*.sig

# #
#   [WL]: Base Files
# #

!*.bat
!*.css
!*.sh
!package.json

# #
#   [WL]: Tauri / Rust
# #

!/src-tauri
!/src-tauri/Cargo.toml
!/src-tauri/Cargo.lock
!/src-tauri/build.rs
!/src-tauri/tauri.conf.json
!/src-tauri/src
!/src-tauri/src/*.rs
!/src-tauri/capabilities
!/src-tauri/capabilities/*.json
!/src-tauri/icons
!/src-tauri/icons/*
/src-tauri/target
/src-tauri/gen
!/ui
!/ui/*
