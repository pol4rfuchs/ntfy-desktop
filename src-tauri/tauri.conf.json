{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ntfy Desktop",
  "version": "2.2.2",
  "identifier": "com.ntfydesktop.id",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Ntfy.sh desktop client",
    "longDescription": "Ntfy.sh desktop client for Windows, Linux, and MacOS with push notifications. Supports official ntfy.sh website and self-hosted instances.",
    "copyright": "GPLv3",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
